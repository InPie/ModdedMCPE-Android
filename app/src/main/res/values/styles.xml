<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/mc_green</item>
        <item name="colorPrimaryDark">@color/mc_green_dark</item>
        <item name="colorAccent">@color/mc_green_light</item>
        <item name="colorError">@color/mc_error</item>
        <item name="colorControlActivated">@color/mc_green</item>
        <item name="android:colorAccent">@color/mc_green_light</item>
        <item name="android:windowBackground">@color/mc_brown_bg</item>
        <item name="android:textColorPrimary">@color/mc_text_dark</item>
        <item name="android:textColorSecondary">@color/mc_brown_panel_light</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="McButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/mc_green</item>
        <item name="android:textColor">@color/mc_button_text</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="McButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/mc_green</item>
        <item name="android:textColor">@color/mc_text_primary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="FullScreenTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="GreenButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/green_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:shadowColor">#80000000</item>
        <item name="android:shadowDx">1.5</item>
        <item name="android:shadowDy">1.5</item>
        <item name="android:shadowRadius">0</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">20dp</item> <!-- 6dp bottom spadow -->
        <item name="android:paddingStart">30dp</item>
        <item name="android:paddingEnd">30dp</item>
        <item name="android:includeFontPadding">true</item>
        <item name="android:gravity">center_horizontal|top</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">10dp</item>
        <!-- <item name="android:fontFamily">@font/minecraft_font</item> -->
    </style>

    <style name="GreenButton.Small">
        <item name="android:textSize">18sp</item>
        <item name="android:padding">12dp</item>
    </style>

    <!-- Legacy MCPE theme (fix colors) -->
    <style name="LegacyMcpeTheme" parent="AppTheme">
        <item name="android:textColorPrimary">@color/mc_text_primary</item>
        <item name="android:textColorSecondary">@color/mc_text_secondary</item>
        <item name="colorOnBackground">@color/mc_text_primary</item>
        <item name="colorOnSurface">@color/mc_text_primary</item>
        <item name="android:editTextColor">@color/mc_text_primary</item>
        <item name="hintTextColor">@color/mc_text_secondary</item>
        <item name="alertDialogTheme">@style/LegacyMcpeAlertDialogTheme</item>
        <item name="android:alertDialogTheme">@style/LegacyMcpeAlertDialogTheme</item>
    </style>

    <style name="LegacyMcpeAlertDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:textColorPrimary">@color/mc_text_dark</item>
        <item name="android:textColorSecondary">@color/mc_brown_panel_light</item>
        <item name="colorOnSurface">@color/mc_text_dark</item>
    </style>

</resources>
