<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:name="me.effently.moddedmcpe.MyApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:exported="true"
        android:supportsRtl="true">
        <meta-data
            android:name="net.hockeyapp.android.appIdentifier"
            android:value="@string/hockeyapp_android_id" />

        <activity
            android:name="me.effently.moddedmcpe.GameManagerActivity"
            android:screenOrientation="sensorLandscape"
            android:label="@string/app_launcher_title"
            android:theme="@style/AppTheme" />
        <activity
            android:name="me.effently.moddedmcpe.AboutUsActivity"
            android:screenOrientation="sensorLandscape"
            android:label="@string/app_info"
            android:theme="@style/AppTheme" />
        <activity
            android:name="me.effently.moddedmcpe.FatalActivity"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/FullScreenTheme" />
        <activity
            android:name="me.effently.moddedmcpe.InitializingActivity"
            android:process=":game"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/FullScreenTheme" />
        <activity
            android:name="me.effently.moddedmcpe.OptionsActivity"
            android:label="@string/app_options"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/AppTheme" />
        <activity
            android:name="me.effently.moddedmcpe.ManageNModsActivity"
            android:label="@string/app_manage_nmods"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/AppTheme" />
        <activity
            android:name="me.effently.moddedmcpe.MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/FullScreenTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Legacy MCPE Activities -->
        <activity
            android:name="me.effently.moddedmcpe.legacy_mcpe.activities.LegacyCreateWorldActivity"
            android:process=":game"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/LegacyMcpeTheme" />
        <activity
            android:name="me.effently.moddedmcpe.legacy_mcpe.activities.LegacyRenameWorldActivity"
            android:process=":game"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/LegacyMcpeTheme" />
        <activity
            android:name="me.effently.moddedmcpe.legacy_mcpe.activities.LegacyGameOptionsActivity"
            android:process=":game"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/LegacyMcpeTheme" />
        <!-- End -->
    </application>

</manifest>