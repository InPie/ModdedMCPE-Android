<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed/Focused State -->
    <item android:state_pressed="true" android:state_enabled="true">
        <layer-list>
            <!-- Main outline -->
            <item android:top="10dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>

            <!-- Bottom shadow: not showing -->
            <item android:left="4dp" android:top="10dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#2a7029" />
                </shape>
            </item>

            <!-- Main green background -->
            <item android:left="4dp" android:top="10dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#2d7d2c" />
                    <stroke
                        android:width="4dp"
                        android:color="#50964f" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default State -->
    <item>
        <layer-list>
            <!-- Main outline -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>

            <!-- Bottom shadow -->
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#2a7029" />
                </shape>
            </item>

            <!-- Main green background -->
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="10dp">
                <shape android:shape="rectangle">
                    <solid android:color="#39a138" />
                    <stroke
                        android:width="4dp"
                        android:color="#69c068" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>